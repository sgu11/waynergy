; Copied to ~/.config/waynergy/config.ini by scripts/install.sh.
; Replace the placeholders or pass --host and --name to the installer.
host=__HOST__
port=__PORT__
name=__NAME__
backend=wlr

[mouse]
; Requires the optional patched package. 0 disables the filter.
wheel_debounce_ms=__WHEEL_DEBOUNCE_MS__

[tls]
enable=true
tofu=true

[log]
level=4
path=__HOME__/.config/waynergy/waynergy.log

[wlr]
; Scale each received wheel notch. The Omarchy panel can select 1, 2, or 3.
wheel_mult=3

[raw-keymap]
; Windows single-byte set-1 scancodes match Linux evdev codes. Adding 8
; converts them to XKB keycodes. E0-prefixed keys need explicit final values.
offset=8
offset_on_explicit=false
284=104
285=105
309=106
311=107
312=108
327=110
328=111
329=112
331=113
333=114
335=115
336=116
337=117
338=118
339=119
347=133
348=134
349=135
