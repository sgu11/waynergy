From a94f6b6b27d006132341e2f836fa7a3d6bb03c66 Mon Sep 17 00:00:00 2001
From: sgu11 <21072846+sgu11@users.noreply.github.com>
Date: Wed, 26 Aug 2026 15:08:55 +0900
Subject: [PATCH] Never debounce the notch that returns from a reversal

The filter keyed off the last notch it emitted, but that notch may itself
have been a bounce that outran the window. When that happened the user's
scroll coming back the other way looked like a fresh reversal and got
eaten -- sometimes several notches in a row -- stranding the view where
the bounce had left it. That is worse than the bounce it was meant to
fix, and it was reproducible in practice, not just in theory:

  dy: -120            emitted
  dy: +120            emitted (late bounce, outran the window)
  dy: -120            DROPPED  <- the user scrolling back
  dy: -120            emitted

Track whether the last emitted notch was itself an unverifiable reversal,
and exempt the notch that comes back from it. A bounce may still slip
through, but it can no longer cost the user the recovery as well.

Bursts are unaffected: inside a run of same-direction notches the flag is
clear, so an isolated reversal is dropped exactly as before.

The return-protection is armed only when the reversal just escaped the
window (plausibly a late bounce mid-scroll); a reversal after a long gap
is a deliberate new direction, so it must not leak the next fast reversal.
---
 include/wayland.h |  1 +
 src/wl_input.c    | 30 +++++++++++++++++++++++++++------
 2 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/include/wayland.h b/include/wayland.h
index 374f254..0baf4ea 100644
--- a/include/wayland.h
+++ b/include/wayland.h
@@ -129,6 +129,7 @@ struct wlContext {
 	/* per-axis debounce state: [0] is horizontal, [1] is vertical */
 	int wheel_last_dir[2];
 	uint32_t wheel_last_ts[2];
+	bool wheel_just_reversed[2];
 	//callbacks
 	void (*on_output_update)(struct wlContext *ctx);
 };
diff --git a/src/wl_input.c b/src/wl_input.c
index ddd0f9a..f085f9b 100644
--- a/src/wl_input.c
+++ b/src/wl_input.c
@@ -304,11 +304,31 @@ static bool wheel_debounce(struct wlContext *ctx, int axis, int delta)
 	now = wlTS(ctx);
 	/* unsigned arithmetic, so this stays correct across wraparound */
 	elapsed = now - ctx->wheel_last_ts[axis];
-	if (ctx->wheel_last_dir[axis] && dir != ctx->wheel_last_dir[axis] &&
-			elapsed < (uint32_t)ctx->wheel_debounce_ms) {
-		logDbg("Wheel debounce: dropping %s reversal (delta %d, %ums after last notch)",
-				axis ? "dy" : "dx", delta, (unsigned)elapsed);
-		return true;
+	if (ctx->wheel_last_dir[axis] && dir != ctx->wheel_last_dir[axis]) {
+		if (ctx->wheel_just_reversed[axis]) {
+			/* The notch we are reversing away from was itself a
+			 * reversal we let through -- possibly a bounce that
+			 * outran the window. This one is the user's scroll
+			 * coming back, so never eat it: doing so strands the
+			 * view where the bounce left it, which is worse than
+			 * the bounce. */
+			ctx->wheel_just_reversed[axis] = false;
+		} else if (elapsed < (uint32_t)ctx->wheel_debounce_ms) {
+			logDbg("Wheel debounce: dropping %s reversal (delta %d, %ums after last notch)",
+					axis ? "dy" : "dx", delta, (unsigned)elapsed);
+			return true;
+		} else {
+			/* A reversal just past the window is ambiguous -- it could
+			 * be a genuine direction change, or a bounce that barely
+			 * escaped. Only arm the return-protection when it arrived
+			 * close to the window (plausibly a late bounce); a large
+			 * gap is a fresh direction change and must not leak the
+			 * next fast reversal. */
+			if (elapsed < 2 * (uint32_t)ctx->wheel_debounce_ms)
+				ctx->wheel_just_reversed[axis] = true;
+		}
+	} else {
+		ctx->wheel_just_reversed[axis] = false;
 	}
 	ctx->wheel_last_dir[axis] = dir;
 	ctx->wheel_last_ts[axis] = now;
