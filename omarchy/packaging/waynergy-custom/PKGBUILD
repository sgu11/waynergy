# Maintainer: sgu11 <21072846+sgu11@users.noreply.github.com>
# Build the public fork directly; all behavior changes live in its root source.
pkgname=waynergy
pkgver=0.0.17
pkgrel=6
pkgdesc="Synergy client for Wayland compositors with Deskflow and Omarchy support"
arch=(x86_64)
url="https://github.com/sgu11/waynergy"
license=('MIT')
depends=('wayland' 'libxkbcommon' 'libretls')
makedepends=(git meson ninja)
optdepends=(
  'wl-clipboard: Clipboard synchronization support'
  'gnome-session: Idle inhibition for GNOME'
)
_commit=1c6ae9443fc2e774616f381770236fc9be7cc589
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        "verify-fork.sh" "verify-fork.c" "verify-debounce.sh" "verify-debounce.c")
sha256sums=('b1432d9635d6f28640ef5a4d5455dfa6d92ace9d6af5f03e7bdcd4e30e1b5f30'
            'd2e2b6c4ccb183916db0d068fb6029bb605ba20330db99f08c3124473a45afce'
            'e41ebdc0ec6cc99477f240188b88e4245dfb8e7b72460dc4354c0e9091434108'
            '1b062e605db07dc8ac76869d1b6351e5b3a218489a89b1f00e027103f4d44049'
            'bf9d28fae2f730545a7c0d91491e5e2a97d3b0171755d0725b43601d944cd137')

prepare() {
  # Stable path for the build and verification helpers across source updates.
  ln -sfn "$pkgname-$_commit" "$srcdir/$pkgname"
}

build() {
  cd "$srcdir/$pkgname"
  meson setup build --prefix=/usr --libdir=lib --sbindir=bin \
    --buildtype=plain --wrap-mode=nodownload -Db_pie=true
  meson compile -C build
}

check() {
  bash "$srcdir/verify-fork.sh" "$srcdir/$pkgname"
  bash "$srcdir/verify-debounce.sh" "$srcdir/$pkgname"
}

package() {
  cd "$srcdir/$pkgname"
  DESTDIR="$pkgdir" meson install -C build --no-rebuild
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
