#!/usr/bin/env bash
# waynergy 상태 판정과 서비스·자동시작 토글. 바 위젯이 호출한다.
#
#   waynergy-ctl state      상태를 종료 코드로만 알린다 (출력 없음)
#   waynergy-ctl info       상태와 주요 설정을 JSON 한 줄로 낸다
#   waynergy-ctl toggle     실행 중이면 멈추고, 멈춰 있으면 시작한다
#   waynergy-ctl start | stop | restart
#   waynergy-ctl refresh-display
#   waynergy-ctl autostart  자동 시작(enable/disable)을 뒤집는다
#   waynergy-ctl enable | disable
#   waynergy-ctl set-wheel-mult 1|2|3
#   waynergy-ctl set-wheel-debounce on|off
#
# state 종료 코드 — 판정은 전부 여기서 한다. QML 은 이 숫자와 JSON 만 읽는다.
#   0  실행 중이고 서버에 붙어 있다
#   1  실행 중이나 서버에 붙지 못했다 (서버 꺼짐·방화벽·TLS 지문 불일치)
#   2  멈춤
#   3  waynergy 미설치 또는 유닛 없음
#
# "실행 중"과 "연결됨"을 나누는 이유: 유닛은 Restart=always 라 서버가 죽어 있어도
# active 로 남는다. 유닛 상태만 보면 입력이 안 오는데 초록불이 켜진다.
# 연결 판정은 로그를 훑지 않고 실제 소켓을 본다 — waynergy 프로세스가 서버
# host:port 로 ESTAB 소켓을 들고 있는지가 유일한 근거다.
set -uo pipefail

BIN=waynergy
UNIT=waynergy.service
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/waynergy/config.ini"
TLSDIR="${XDG_CONFIG_HOME:-$HOME/.config}/waynergy/tls"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a waynergy "$1" "${2:-}"; }

have_unit() { systemctl --user cat "$UNIT" >/dev/null 2>&1; }
installed()  { command -v "$BIN" >/dev/null 2>&1 && have_unit; }

# config.ini 파서. Waynergy의 INI 구현이 인식하는 주석 표시는 ';'다.
# 섹션 밖 키(host/port)와 섹션 안 키를 "섹션.키" 로 평평하게 만든다.
conf() {  # conf <섹션.키>  — 없으면 빈 문자열
  awk -v want="$1" '
    /^[[:space:]]*;/ { next }
    /^[[:space:]]*\[/ { sec = $0; gsub(/[][[:space:]]/, "", sec); next }
    /=/ {
      key = $0; sub(/=.*/, "", key); gsub(/[[:space:]]/, "", key)
      val = $0; sub(/[^=]*=/, "", val); sub(/;.*/, "", val)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      full = (sec == "" ? key : sec "." key)
      if (full == want) { print val; exit }
    }
  ' "$CONFIG" 2>/dev/null
}

# [raw-keymap] 의 명시 매핑 개수. offset 관련 키는 매핑이 아니므로 뺀다.
raw_keymap_count() {
  awk '
    /^[[:space:]]*;/ { next }
    /^[[:space:]]*\[/ { sec = $0; gsub(/[][[:space:]]/, "", sec); next }
    sec == "raw-keymap" && /=/ {
      key = $0; sub(/=.*/, "", key); gsub(/[[:space:]]/, "", key)
      if (key ~ /^[0-9]+$/) n++
    }
    END { print n + 0 }
  ' "$CONFIG" 2>/dev/null
}

effective_keymap_offset() {
  local raw legacy
  raw="$(conf raw-keymap.offset)"
  legacy="$(conf xkb_key_offset)"
  [[ "$raw" =~ ^-?[0-9]+$ ]] || raw=0
  [[ "$legacy" =~ ^-?[0-9]+$ ]] || legacy=0
  printf '%s\n' "$((raw + legacy))"
}

unit_prop() { systemctl --user show "$UNIT" -p "$1" --value 2>/dev/null; }

# 서버와의 실제 TCP 연결. waynergy 프로세스가 소유한 ESTAB 소켓만 센다.
connected() {
  local host port out
  host="$(conf host)"; port="$(conf port)"
  [ -n "$host" ] && [ -n "$port" ] || return 1
  # `ss ... | grep -q` 를 쓰지 않는다. grep -q 는 첫 일치에서 바로 닫고, 그러면
  # ss 가 SIGPIPE 로 죽어 pipefail 이 파이프라인을 실패로 만든다. 출력이 짧으면
  # ss 가 먼저 끝나 통과하므로 증상이 들쭉날쭉해진다. 이 저장소는 같은 함정을
  # 이미 한 번 밟았다 — verify.sh 의 adguard 인증서 검사 주석 참고.
  # 먼저 출력을 받아 두고 문자열로 검사한다.
  out="$(ss -tnpH state established "dst $host:$port" 2>/dev/null)"
  case "$out" in
    *'"waynergy"'*) return 0 ;;
  esac
  return 1
}

state() {
  installed || return 3
  [ "$(unit_prop ActiveState)" = "active" ] || return 2
  connected && return 0
  return 1
}

json_bool() { [ "$1" -eq 0 ] && printf 'true' || printf 'false'; }
json_str()  { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

info() {
  local st active autostart conn ver
  state; st=$?
  [ "$(unit_prop ActiveState)" = "active" ]; active=$?
  systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; autostart=$?
  connected; conn=$?
  ver="$(pacman -Q "$BIN" 2>/dev/null | awk '{print $2}')"
  # 명령행 -L 이 있으면 그 값이 우선이고, 없으면 config 의 log/level 을 쓴다.
  local level
  level="$(unit_prop ExecStart | grep -oE '\-L (none|error|warn|info|debug|debugsyn|[0-6])' | awk '{print $2}')"
  [ -n "$level" ] || level="$(conf log.level)"

  printf '{'
  printf '"state":%d,' "$st"
  printf '"installed":%s,' "$(installed; json_bool $?)"
  printf '"active":%s,' "$(json_bool $active)"
  printf '"connected":%s,' "$(json_bool $conn)"
  printf '"autostart":%s,' "$(json_bool $autostart)"
  printf '"version":"%s",' "$(json_str "$ver")"
  printf '"unitState":"%s",' "$(json_str "$(unit_prop ActiveState)")"
  printf '"subState":"%s",' "$(json_str "$(unit_prop SubState)")"
  printf '"since":"%s",' "$(json_str "$(unit_prop ActiveEnterTimestamp)")"
  printf '"host":"%s",' "$(json_str "$(conf host)")"
  printf '"port":"%s",' "$(json_str "$(conf port)")"
  printf '"wheelDebounceMs":"%s",' "$(json_str "$(conf mouse.wheel_debounce_ms)")"
  printf '"wheelDebounceSupported":%s,' "$(debounce_supported; json_bool $?)"
  printf '"wheelMult":"%s",' "$(json_str "$(conf wlr.wheel_mult)")"
  # Waynergy adds raw-keymap/offset and the legacy global xkb_key_offset.
  # Report the effective value so old and new config formats display alike.
  printf '"keymapOffset":"%s",' "$(effective_keymap_offset)"
  printf '"keymapExplicit":%s,' "$(raw_keymap_count)"
  printf '"tls":"%s",' "$(json_str "$(conf tls.enable)")"
  printf '"tofu":"%s",' "$(json_str "$(conf tls.tofu)")"
  local pin
  pin="$(find "$TLSDIR" -maxdepth 1 -type f \
    ! -name openssl.cnf ! -name generate-client-cert.sh ! -name cert \
    -print -quit 2>/dev/null)"
  printf '"pinned":%s,' "$([ -n "$pin" ]; json_bool $?)"
  printf '"logLevel":"%s"' "$(json_str "$level")"
  printf '}\n'
}

# 전환이 실제로 일어났는지 상태로 확인한다. 종료 코드는 믿지 않는다.
# active/inactive 만 본다 — 연결(0)과 미연결(1) 둘 다 "켜짐"이기 때문이다.
settled() {  # settled active|inactive
  local want=$1 i
  for i in $(seq 1 12); do
    local now; now="$(unit_prop ActiveState)"
    [ "$now" = "$want" ] && return 0
    sleep 0.25
  done
  return 1
}

# 시작 전에 반드시 reset-failed 를 한다. 짧은 시간에 껐다 켜기를 반복하면
# 유닛이 start-limit-hit 으로 failed 에 갇히고, 그 상태에서는 start 가 조용히
# 실패한다. 이 서비스는 이 세션의 입력 경로라서 그렇게 갇히면 되살릴 입력
# 수단이 없다 — 실측으로 겪었다(2026-08-26). 이미 정상일 때 reset-failed 는
# 아무 일도 하지 않으므로 항상 걸어 둔다.
do_start() {
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
  systemctl --user start "$UNIT" >/dev/null 2>&1
  settled active || notify "시작 실패" "journalctl --user -u $UNIT -e"
}
do_stop()  { systemctl --user stop  "$UNIT" >/dev/null 2>&1; settled inactive || notify "정지 실패" "journalctl --user -u $UNIT -e"; }

# Waynergy caches the compositor's output and virtual-input geometry. It normally
# announces changes to the Deskflow server with DINF, but output removal can
# leave the wlroots backend with stale geometry. Upstream explicitly supports
# SIGUSR1 as an in-process re-exec, which rebuilds that state without involving
# systemd's restart/start-limit path.
refresh_display() {
  installed || return 3
  [ "$(unit_prop ActiveState)" = "active" ] || return 0
  if ! systemctl --user kill --kill-who=main --signal=SIGUSR1 "$UNIT" >/dev/null 2>&1; then
    notify "화면 정보 갱신 실패" "journalctl --user -u $UNIT -e"
    return 1
  fi
}

debounce_supported() {
  local bin out
  bin="$(command -v "$BIN" 2>/dev/null || true)"
  [ -n "$bin" ] || return 1
  out="$(strings "$bin" 2>/dev/null || true)"
  case "$out" in
    *"Wheel debounce enabled"*) return 0 ;;
  esac
  return 1
}

set_wheel_debounce() {
  local value="${1:-}" current target tmp backup
  case "$value" in on|off) ;; *) echo "wheel debounce must be on or off" >&2; return 64 ;; esac
  [ -f "$CONFIG" ] || { notify "설정 없음" "$CONFIG"; return 3; }
  if [ "$value" = on ]; then
    debounce_supported || { notify "디바운스 패키지 필요" "패치된 waynergy를 설치하세요"; return 3; }
    current="$(conf mouse.wheel_debounce_ms)"
    target="$current"
    [[ "$target" =~ ^[1-9][0-9]*$ ]] || target=100
  else
    target=0
  fi
  [ "$(conf mouse.wheel_debounce_ms)" = "$target" ] && return 0

  tmp="$(mktemp "${CONFIG}.tmp.XXXXXX")" || return 1
  backup="${CONFIG}.bak.$(date +%Y%m%d%H%M%S)"
  cp -p -- "$CONFIG" "$backup" || { rm -f -- "$tmp"; return 1; }
  if ! awk -v value="$target" '
    BEGIN { section=""; saw_mouse=0; wrote=0 }
    /^[[:space:]]*\[/ {
      if (section == "mouse" && !wrote) { print "wheel_debounce_ms=" value; wrote=1 }
      section=$0; gsub(/[][[:space:]]/, "", section)
      if (section == "mouse") saw_mouse=1
    }
    section == "mouse" && /^[[:space:]]*wheel_debounce_ms[[:space:]]*=/ {
      if (!wrote) print "wheel_debounce_ms=" value
      wrote=1
      next
    }
    { print }
    END {
      if (section == "mouse" && !wrote) print "wheel_debounce_ms=" value
      else if (!saw_mouse) { print ""; print "[mouse]"; print "wheel_debounce_ms=" value }
    }
  ' "$CONFIG" >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  chmod --reference="$CONFIG" "$tmp"
  mv -- "$tmp" "$CONFIG"

  installed || return 3
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
  systemctl --user restart "$UNIT" >/dev/null 2>&1
  settled active || { notify "디바운스 적용 실패" "journalctl --user -u $UNIT -e"; return 1; }
}

set_wheel_mult() {
  local value="${1:-}" tmp backup
  case "$value" in 1|2|3) ;; *) echo "wheel multiplier must be 1, 2, or 3" >&2; return 64 ;; esac
  [ -f "$CONFIG" ] || { notify "설정 없음" "$CONFIG"; return 3; }
  [ "$(conf wlr.wheel_mult)" = "$value" ] && return 0

  tmp="$(mktemp "${CONFIG}.tmp.XXXXXX")" || return 1
  backup="${CONFIG}.bak.$(date +%Y%m%d%H%M%S)"
  cp -p -- "$CONFIG" "$backup" || { rm -f -- "$tmp"; return 1; }
  if ! awk -v value="$value" '
    BEGIN { section=""; saw_wlr=0; wrote=0 }
    /^[[:space:]]*\[/ {
      if (section == "wlr" && !wrote) { print "wheel_mult=" value; wrote=1 }
      section=$0; gsub(/[][[:space:]]/, "", section)
      if (section == "wlr") saw_wlr=1
    }
    section == "wlr" && /^[[:space:]]*wheel_mult[[:space:]]*=/ {
      if (!wrote) print "wheel_mult=" value
      wrote=1
      next
    }
    { print }
    END {
      if (section == "wlr" && !wrote) print "wheel_mult=" value
      else if (!saw_wlr) { print ""; print "[wlr]"; print "wheel_mult=" value }
    }
  ' "$CONFIG" >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  chmod --reference="$CONFIG" "$tmp"
  mv -- "$tmp" "$CONFIG"

  installed || return 3
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
  systemctl --user restart "$UNIT" >/dev/null 2>&1
  settled active || { notify "휠 배수 적용 실패" "journalctl --user -u $UNIT -e"; return 1; }
}

case "${1:-state}" in
  state) state; exit $? ;;
  info)  info; exit 0 ;;
  start) installed || { notify "waynergy 없음" "yay -S waynergy"; exit 3; }; do_start ;;
  stop)  do_stop ;;
  restart) installed || exit 3; systemctl --user reset-failed "$UNIT" >/dev/null 2>&1; systemctl --user restart "$UNIT" >/dev/null 2>&1; settled active || notify "재시작 실패" "journalctl --user -u $UNIT -e" ;;
  refresh-display) refresh_display ;;
  toggle)
    installed || { notify "waynergy 없음" "yay -S waynergy"; exit 3; }
    if [ "$(unit_prop ActiveState)" = "active" ]; then do_stop; else do_start; fi
    ;;
  enable)  systemctl --user enable "$UNIT" >/dev/null 2>&1 ;;
  disable) systemctl --user disable "$UNIT" >/dev/null 2>&1 ;;
  autostart)
    if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; then
      systemctl --user disable "$UNIT" >/dev/null 2>&1
    else
      systemctl --user enable "$UNIT" >/dev/null 2>&1
    fi
    ;;
  set-wheel-mult) set_wheel_mult "${2:-}" ;;
  set-wheel-debounce) set_wheel_debounce "${2:-}" ;;
  *) echo "usage: waynergy-ctl {state|info|toggle|start|stop|restart|refresh-display|autostart|enable|disable|set-wheel-mult 1|2|3|set-wheel-debounce on|off}" >&2; exit 64 ;;
esac
