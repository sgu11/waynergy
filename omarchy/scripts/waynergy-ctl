#!/usr/bin/env bash
# waynergy 상태 판정과 서비스·자동시작 토글. 바 위젯이 호출한다.
#
#   waynergy-ctl state      상태를 종료 코드로만 알린다 (출력 없음)
#   waynergy-ctl info       상태와 주요 설정을 JSON 한 줄로 낸다
#   waynergy-ctl toggle     실행 중이면 멈추고, 멈춰 있으면 시작한다
#   waynergy-ctl start | stop | restart
#   waynergy-ctl refresh-display
#   waynergy-ctl autostart  자동 시작(enable/disable)을 뒤집는다
#   waynergy-ctl enable | disable
#   waynergy-ctl set-wheel-mult 1|2|3
#   waynergy-ctl set-wheel-debounce on|off
#
# state 종료 코드 — 판정은 전부 여기서 한다. QML 은 이 숫자와 JSON 만 읽는다.
#   0  실행 중이고 서버에 붙어 있다
#   1  실행 중이나 서버에 붙지 못했다 (서버 꺼짐·방화벽·TLS 지문 불일치)
#   2  멈춤
#   3  waynergy 미설치 또는 유닛 없음
#
# "실행 중"과 "연결됨"을 나누는 이유: 유닛은 Restart=always 라 서버가 죽어 있어도
# active 로 남는다. 유닛 상태만 보면 입력이 안 오는데 초록불이 켜진다.
# 연결 판정은 유닛의 MainPID가 서버 host:port로 ESTAB 소켓을 소유하는지 본다.
set -uo pipefail

BIN=waynergy
UNIT=waynergy.service
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/waynergy/config.ini"
TLSDIR="${XDG_CONFIG_HOME:-$HOME/.config}/waynergy/tls"
declare -A config=() unit=()

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a waynergy "$1" "${2:-}"; }

have_unit() { systemctl --user cat "$UNIT" >/dev/null 2>&1; }
installed()  { command -v "$BIN" >/dev/null 2>&1 && have_unit; }

read_config() {
  local key value
  config=()
  [[ -r "$CONFIG" ]] || return 0
  while IFS='=' read -r key value; do
    config[$key]=$value
  done < <(awk '
    /^[[:space:]]*;/ { next }
    /^[[:space:]]*\[/ {
      sec = $0; sub(/^[^[]*\[/, "", sec); sub(/\].*$/, "", sec)
      sec = tolower(sec)
      next
    }
    /=/ {
      key = $0; sub(/=.*/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      key = tolower(key)
      val = $0; sub(/[^=]*=/, "", val); sub(/;.*/, "", val)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      field = (sec == "" ? key : sec "." key)
      if (sec == "raw-keymap" && key ~ /^([0-9]+|0x[0-9a-f]+)$/) n++
      if (field ~ /^(host|port|xkb_key_offset|raw-keymap\.offset|mouse\.wheel_debounce_ms|wlr\.wheel_mult|tls\.(enable|tofu)|log\.level)$/ && !seen[field]++)
        print field "=" val
    }
    END { print "keymapExplicit=" n + 0 }
  ' "$CONFIG" 2>/dev/null)
}

effective_keymap_offset() {
  local raw="${config[raw-keymap.offset]-}" legacy="${config[xkb_key_offset]-}"
  local number='^[+-]?(0[xX][[:xdigit:]]+|0[0-7]*|[1-9][0-9]*)$'
  [[ "$raw" =~ $number ]] || raw=0
  [[ "$legacy" =~ $number ]] || legacy=0
  printf '%s\n' "$((raw + legacy))"
}

unit_prop() { systemctl --user show "$UNIT" -p "$1" --value 2>/dev/null; }

# 서버와의 실제 TCP 연결. waynergy 프로세스가 소유한 ESTAB 소켓만 센다.
connected() {
  local pid="${unit[MainPID]-}" host="${config[host]-localhost}" port="${config[port]-24800}" sockets
  [[ "$pid" =~ ^[1-9][0-9]*$ && -n "$host" && -n "$port" ]] || return 1
  [[ "$host" != *:* ]] || host="[$host]"
  sockets=$(timeout --kill-after=1s 2s ss -tnpH state established "dst $host and dport = $port" 2>/dev/null) || return 1
  [[ "$sockets" == *"pid=$pid,"* ]]
}

read_status() {
  local key value properties
  command -v "$BIN" >/dev/null || return 3
  properties=$(systemctl --user show "$UNIT" -p LoadState -p ActiveState -p MainPID \
    -p UnitFileState -p SubState -p ActiveEnterTimestamp -p ExecStart 2>/dev/null) || return 3
  while IFS='=' read -r key value; do
    [[ -n "$key" ]] && unit[$key]=$value
  done <<< "$properties"
  case "${unit[LoadState]-}" in loaded|masked) ;; *) return 3 ;; esac
  [[ "${unit[ActiveState]-}" == active ]] || return 2
  connected && return 0
  return 1
}

json_string() {
  local key=$1 value=$2
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  if [[ "$value" == *[$'\001'-$'\037']* ]]; then
    local i char escaped result=""
    for ((i = 0; i < ${#value}; ++i)); do
      char=${value:i:1}
      if [[ "$char" == [$'\001'-$'\037'] ]]; then
        printf -v escaped '\\u%04x' "'$char"
        result+=$escaped
      else
        result+=$char
      fi
    done
    value=$result
  fi
  printf '"%s":"%s"' "$key" "$value"
}

info() {
  local st installed=false active=false conn=false autostart=false supported=false pinned=false
  local ver="" version_output host="${config[host]-localhost}" level="${config[log.level]-}"
  read_status; st=$?
  ((st < 3)) && installed=true
  ((st < 2)) && active=true
  ((st == 0)) && conn=true
  case "${unit[UnitFileState]-}" in
    enabled|enabled-runtime|alias|static|indirect|generated|transient) autostart=true ;;
  esac
  if version_output=$(pacman -Q "$BIN" 2>/dev/null); then
    read -r _ ver _ <<< "$version_output"
  fi
  debounce_supported && supported=true
  [[ -f "$TLSDIR/hash/$host" ]] && pinned=true
  # 명령행 -L 이 있으면 그 값이 우선이고, 없으면 config 의 log/level 을 쓴다.
  local level_arg='-L[[:space:]]+(none|error|warn|info|debugsyn|debug|[0-6])([[:space:];}]|$)'
  [[ "${unit[ExecStart]-}" =~ $level_arg ]] && level=${BASH_REMATCH[1]}

  printf '{"state":%d,"installed":%s,"active":%s,"connected":%s,"autostart":%s,' \
    "$st" "$installed" "$active" "$conn" "$autostart"
  printf '"wheelDebounceSupported":%s,"keymapExplicit":%s,"pinned":%s,' \
    "$supported" "${config[keymapExplicit]:-0}" "$pinned"
  json_string version "$ver"; printf ','
  json_string unitState "${unit[ActiveState]-}"; printf ','
  json_string subState "${unit[SubState]-}"; printf ','
  json_string since "${unit[ActiveEnterTimestamp]-}"; printf ','
  json_string host "$host"; printf ','
  json_string port "${config[port]-24800}"; printf ','
  json_string wheelDebounceMs "${config[mouse.wheel_debounce_ms]-}"; printf ','
  json_string wheelMult "${config[wlr.wheel_mult]-}"; printf ','
  json_string keymapOffset "$(effective_keymap_offset)"; printf ','
  json_string tls "${config[tls.enable]-}"; printf ','
  json_string tofu "${config[tls.tofu]-}"; printf ','
  json_string logLevel "$level"
  printf '}\n'
}

# 전환이 실제로 일어났는지 상태로 확인한다. 종료 코드는 믿지 않는다.
# active/inactive 만 본다 — 연결(0)과 미연결(1) 둘 다 "켜짐"이기 때문이다.
settled() {  # settled active|inactive
  local want=$1 i
  for i in {1..12}; do
    local now; now="$(unit_prop ActiveState)"
    [ "$now" = "$want" ] && return 0
    sleep 0.25
  done
  return 1
}

# 시작 전에 반드시 reset-failed 를 한다. 짧은 시간에 껐다 켜기를 반복하면
# 유닛이 start-limit-hit 으로 failed 에 갇히고, 그 상태에서는 start 가 조용히
# 실패한다. 이 서비스는 이 세션의 입력 경로라서 그렇게 갇히면 되살릴 입력
# 수단이 없다 — 실측으로 겪었다(2026-08-26). 이미 정상일 때 reset-failed 는
# 아무 일도 하지 않으므로 항상 걸어 둔다.
do_start() {
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
  systemctl --user start "$UNIT" >/dev/null 2>&1
  confirm_state active "시작 실패"
}
do_stop() {
  systemctl --user stop "$UNIT" >/dev/null 2>&1
  confirm_state inactive "정지 실패"
}
do_restart() {
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
  systemctl --user restart "$UNIT" >/dev/null 2>&1
  confirm_state active "재시작 실패"
}
confirm_state() {
  settled "$1" && return 0
  notify "$2" "journalctl --user -u $UNIT -e" || true
  return 1
}

# Waynergy caches the compositor's output and virtual-input geometry. It normally
# announces changes to the Deskflow server with DINF, but output removal can
# leave the wlroots backend with stale geometry. Upstream explicitly supports
# SIGUSR1 as an in-process re-exec, which rebuilds that state without involving
# systemd's restart/start-limit path.
refresh_display() {
  installed || return 3
  [ "$(unit_prop ActiveState)" = "active" ] || return 0
  if ! systemctl --user kill --kill-who=main --signal=SIGUSR1 "$UNIT" >/dev/null 2>&1; then
    notify "화면 정보 갱신 실패" "journalctl --user -u $UNIT -e"
    return 1
  fi
}

debounce_supported() {
  local bin
  bin=$(command -v "$BIN") || return 1
  LC_ALL=C grep -aFq 'Wheel debounce enabled' "$bin" 2>/dev/null
}

# Serialize read/backup/replace/reload across concurrent wheel edits.
set_wheel_option() (
  local section=$1 key=$2 value=$3 current lock tmp backup
  [[ -f "$CONFIG" ]] || { notify "설정 없음" "$CONFIG"; return 3; }
  exec {lock}>>"$CONFIG.lock" && flock "$lock" || return 1
  read_config
  current=${config[$section.$key]-}
  if [[ "$value" == on ]]; then
    debounce_supported || { notify "디바운스 패키지 필요" "패치된 waynergy를 설치하세요"; return 3; }
    value=100
    [[ "$current" =~ ^[1-9][0-9]*$ ]] && value=$current
  fi
  [[ "$current" != "$value" ]] || return 0
  installed || return 3

  tmp=$(mktemp "${CONFIG}.tmp.XXXXXX") || return 1
  trap 'rm -f -- "$tmp"' EXIT
  if ! awk -v section="$section" -v target="$key" -v value="$value" '
    function write_setting() { print target "=" value; wrote = 1 }
    /^[[:space:]]*\[/ {
      if (sec == section && !wrote) write_setting()
      sec = $0; sub(/^[^[]*\[/, "", sec); sub(/\].*$/, "", sec)
      sec = tolower(sec)
    }
    sec == section && /^[[:space:]]*[^;].*=/ {
      key = $0; sub(/=.*/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      if (tolower(key) == target) {
        if (!wrote) write_setting()
        next
      }
    }
    { print }
    END {
      if (!wrote) {
        if (sec != section) { print ""; print "[" section "]" }
        write_setting()
      }
    }
  ' "$CONFIG" >"$tmp"; then
    return 1
  fi
  chmod --reference="$CONFIG" "$tmp" || return 1
  backup=$(mktemp "${CONFIG}.bak.$(date +%Y%m%d%H%M%S).XXXXXX") || return 1
  cp -p -- "$CONFIG" "$backup" || { rm -f -- "$backup"; return 1; }
  mv -Tf -- "$tmp" "$CONFIG" || return 1

  if ! systemctl --user try-restart "$UNIT"; then
    if ! cp -p -- "$backup" "$tmp" || ! mv -Tf -- "$tmp" "$CONFIG"; then
      printf 'Could not restore the previous configuration from %s\n' "$backup" >&2
    fi
    notify "휠 설정 적용 실패" "journalctl --user -u $UNIT -e" || true
    return 1
  fi
)

set_wheel_debounce() {
  case "${1:-}" in
    on) set_wheel_option mouse wheel_debounce_ms on ;;
    off) set_wheel_option mouse wheel_debounce_ms 0 ;;
    *) echo "wheel debounce must be on or off" >&2; return 64 ;;
  esac
}

set_wheel_mult() {
  case "${1:-}" in
    1|2|3) set_wheel_option wlr wheel_mult "$1" ;;
    *) echo "wheel multiplier must be 1, 2, or 3" >&2; return 64 ;;
  esac
}

case "${1:-state}" in
  state) read_config; read_status; exit $? ;;
  info)  read_config; info ;;
  start) installed || { notify "waynergy 없음" "yay -S waynergy"; exit 3; }; do_start ;;
  stop)  do_stop ;;
  restart) installed || exit 3; do_restart ;;
  refresh-display) refresh_display ;;
  toggle)
    installed || { notify "waynergy 없음" "yay -S waynergy"; exit 3; }
    if [ "$(unit_prop ActiveState)" = "active" ]; then do_stop; else do_start; fi
    ;;
  enable)  systemctl --user enable "$UNIT" >/dev/null 2>&1 ;;
  disable) systemctl --user disable "$UNIT" >/dev/null 2>&1 ;;
  autostart)
    if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; then
      systemctl --user disable "$UNIT" >/dev/null 2>&1
    else
      systemctl --user enable "$UNIT" >/dev/null 2>&1
    fi
    ;;
  set-wheel-mult) set_wheel_mult "${2:-}" ;;
  set-wheel-debounce) set_wheel_debounce "${2:-}" ;;
  *) echo "usage: waynergy-ctl {state|info|toggle|start|stop|restart|refresh-display|autostart|enable|disable|set-wheel-mult 1|2|3|set-wheel-debounce on|off}" >&2; exit 64 ;;
esac
