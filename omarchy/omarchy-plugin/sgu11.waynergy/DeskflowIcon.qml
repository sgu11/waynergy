import QtQuick
import QtQuick.Shapes
import qs.Commons

// Deskflow 단색 아이콘.
//
// 출처는 deskflow 패키지가 설치하는 symbolic(단색) 아이콘이다 —
// /usr/share/icons/hicolor/symbolic/apps/org.deskflow.deskflow-symbolic.svg.
// SVG 를 Image 로 읽지 않고 경로를 그대로 옮겨 Shape 로 그린다. 바 아이콘 크기의
// SVG 는 렌더링이 뭉개지고(첫 파티 tailscale 위젯이 같은 이유로 직접 그린다),
// 그 SVG 는 색을 currentColor 로 두는데 Qt 의 SVG 리더는 currentColor 를 풀지
// 못해 테마 색을 입힐 수 없다.
//
// 경로는 원본의 transform=matrix(...) 를 좌표에 미리 적용해 64x64 뷰박스
// 좌표로 바꿔 둔 것이다. 원본과 재생성본을 256px 로 렌더해 픽셀 비교했고
// 차이는 반올림 수준이었다(AE 1.5 / 65536).
Item {
  id: root

  property real iconSize: Style.font.icon
  property color color: Color.foreground

  implicitWidth: iconSize
  implicitHeight: iconSize
  width: iconSize
  height: iconSize

  // 가장자리 품질은 두 겹으로 만든다.
  //
  // 1) CurveRenderer — 곡선을 삼각형으로 미리 쪼개지 않고 픽셀 단위로 푸는
  //    렌더러다. 실제로 붙었는지는 첫 프레임 뒤 rendererType 으로 확인했다
  //    (4 = CurveRenderer). 생성 시점에는 0(미정)이라 그때 읽으면 헛읽는다.
  // 2) 2배 슈퍼샘플링 — layer 를 켜되 텍스처 크기를 **이 Item 의 크기(64px)가
  //    아니라 최종 아이콘 크기의 2배**로 잡는다. 그러면 도형이 2배 해상도로
  //    래스터라이즈된 뒤 bilinear 로 정확히 절반으로 줄어든다. 축소비가 2배면
  //    출력 픽셀 하나가 텍셀 4개를 덮고 bilinear 가 그 4개를 정확히 평균하므로
  //    손실이 없다.
  //
  // layer.textureSize 를 주지 않으면 텍스처가 Item 크기(64px)로 잡혀 바 크기로
  // 3~4배 축소된다. 그 배율에서는 bilinear 가 텍셀을 건너뛰어 계단이 남는다 —
  // 처음 만들 때 그렇게 해서 "픽셀레이트하다"는 지적을 받았다.
  //
  // 배수는 2가 맞다. 3배도 재어 봤는데 오히려 나빴다. 같은 이유로 bilinear 가
  // 텍셀 9개 중 4개만 보기 때문이다. 26x24 창의 고유 회색 계조로 재면
  // 2배 106 · layer 없음 84 · 3배 50 이고, 눈으로도 순서가 같다.
  Shape {
    width: 64
    height: 64
    antialiasing: true
    preferredRendererType: Shape.CurveRenderer
    layer.enabled: true
    layer.smooth: true
    layer.textureSize: Qt.size(Math.ceil(root.iconSize * 2), Math.ceil(root.iconSize * 2))
    transform: Scale { xScale: root.iconSize / 64; yScale: root.iconSize / 64 }

    ShapePath {
      fillColor: root.color
      strokeWidth: 0
      PathSvg { path: "M 42.101 55.931 C 37.822 55.454 34.154 53.137 30.403 51.351 C 27.83 50.17 25.28 48.564 22.344 48.374 C 20.587 48.259 18.787 48.43 17.262 49.314 C 14.997 50.389 13.535 52.385 11.691 53.923 C 9.747 55.002 8.025 52.845 8.112 51.16 C 7.873 48.814 9.998 47.124 11.589 45.596 C 14.441 42.975 18.422 41.148 22.512 41.616 C 27.338 42.12 31.425 44.785 35.655 46.77 C 38.564 48.199 41.855 49.883 45.25 48.952 C 48.346 48.154 50.065 45.466 52.115 43.406 C 53.616 42.179 55.692 43.735 55.827 45.318 C 56.346 47.282 55.009 48.971 53.734 50.393 C 51.318 53.311 47.841 55.748 43.755 55.967 C 43.204 56.033 42.65 55.988 42.101 55.931 Z" }
    }

    ShapePath {
      fillColor: root.color
      strokeWidth: 0
      PathSvg { path: "M 41.633 39.174 C 36.812 38.398 32.748 35.664 28.466 33.645 C 25.977 32.388 23.203 31.273 20.303 31.658 C 16.933 32.003 14.447 34.443 12.352 36.699 C 11.072 38.278 8.705 37.283 8.268 35.585 C 7.52 33.763 8.437 31.822 9.822 30.501 C 12.838 27.193 17.205 24.422 22.073 24.792 C 27.578 25.198 32.104 28.435 36.926 30.595 C 39.394 31.835 42.227 32.905 45.072 32.25 C 48.09 31.501 49.922 28.973 51.781 26.849 C 52.868 25.424 55.127 26.176 55.622 27.67 C 56.443 29.416 55.801 31.413 54.505 32.802 C 51.886 36.227 47.891 39.35 43.122 39.241 C 42.625 39.247 42.126 39.236 41.633 39.174 Z" }
    }

    ShapePath {
      fillColor: root.color
      strokeWidth: 0
      PathSvg { path: "M 41.22 22.368 C 35.129 21.347 30.368 17.264 24.626 15.384 C 21.905 14.614 18.775 14.773 16.423 16.373 C 14.554 17.422 13.307 19.125 11.742 20.477 C 10.282 21.433 8.582 20.144 8.247 18.763 C 7.506 16.882 8.548 14.888 10.006 13.568 C 12.956 10.317 17.289 7.669 22.045 8.034 C 27.606 8.461 32.205 11.704 37.055 13.939 C 39.735 15.298 43.02 16.386 46.005 15.184 C 48.663 14.182 50.246 11.851 51.98 9.872 C 53.377 8.529 55.6 9.947 55.841 11.514 C 56.353 13.209 55.567 14.911 54.383 16.193 C 51.821 19.522 47.958 22.529 43.329 22.525 C 42.623 22.532 41.916 22.477 41.22 22.368 Z" }
    }
  }
}
